# Copy to .env. Use the host from MongoDB Atlas, which ends in .mongodb.net.
# Do not commit .env.
NEXT_PUBLIC_APP_NAME=NEEDIT
# Browser key for Maps JavaScript API and Geocoding API. Restrict it by website.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/needit
AUTH_SECRET=replace-with-a-long-random-string
# Optional. If these are empty, order alerts generate a key pair in data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public site address used in email links.
APP_URL=http://localhost:3000
# Mailjet. MAIL_FROM must be a sender validated in the Mailjet account.
MAIL_JET_API_KEY=
MAIL_JET_API_SECRET=
MAIL_FROM=NEEDIT <orders@yourdomain.com>
