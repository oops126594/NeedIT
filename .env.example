# Copy to .env. Use the host from MongoDB Atlas, which ends in .mongodb.net.
# Do not commit .env.
NEXT_PUBLIC_APP_NAME=NEEDIT
# Browser key for Maps JavaScript API and Geocoding API. Restrict it by website.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/needit
AUTH_SECRET=replace-with-a-long-random-string
# Optional estimated fuel rates in halalas per liter. Confirm against the provider before launch.
FUEL_91_HALALAS_PER_LITER=218
FUEL_95_HALALAS_PER_LITER=233
DIESEL_HALALAS_PER_LITER=179
# Optional monthly admin cost estimates, in halalas. These are not provider invoices.
MONTHLY_INFRA_COST_HALALAS=45000
MONTHLY_MAPS_COST_HALALAS=15000
MONTHLY_MESSAGING_COST_HALALAS=10000
MONTHLY_OPERATIONS_COST_HALALAS=30000
# Optional. If these are empty, order alerts generate a key pair in data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public site address used in email links.
APP_URL=http://localhost:3000
# Public https origin the Google Play app opens. Localhost cannot be used here.
CAPACITOR_SERVER_URL=https://your-domain.com
# Mailjet. MAIL_FROM must be a sender validated in the Mailjet account.
MAIL_JET_API_KEY=
MAIL_JET_API_SECRET=
MAIL_FROM=NEEDIT <orders@yourdomain.com>
